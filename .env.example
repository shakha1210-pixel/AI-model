# ============================================================
# KOD YOZISH AGENTI — MUHIT O'ZGARUVCHILARI (NAMUNA)
# ============================================================
# Bu — .env faylining namunasi (haqiqiy kalitlarsiz). Haqiqiy qiymatlarni
# shu papkadagi .env fayliga kiriting, bu faylga EMAS.

# --- AI API kalitlari (MAJBURIY) -----------------------------------------
# Claude (Anthropic) kaliti: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini (Google AI) kaliti: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Leonardo AI (rasm generatsiya) kaliti: https://app.leonardo.ai/api-access
LEONARDO_API_KEY=

# --- Model nomlari (ixtiyoriy, standart qiymatlar ishlatiladi) -----------
CLAUDE_MODEL=claude-sonnet-4-5-20250929
GEMINI_MODEL=gemini-2.5-flash
# "Qidiruv/hujjat tahlili" domeni uchun kuchliroq Gemini modeli
# (Google modellarni tez-tez yangilaydi/eskirtiradi — agar bu domen xato
# bersa, birinchi navbatda shu qiymatni tekshiring)
GEMINI_RESEARCH_MODEL=gemini-3.5-flash
# Leonardo AI model ID'si (standart: Leonardo Phoenix)
LEONARDO_MODEL_ID=b24e16ff-06e3-43eb-8d33-4416c2d75876

# --- Bosqichlarni yoqish/o'chirish (main.py fayliga qarang) --------------
ENABLE_DATABASE=false
ENABLE_AUTH=false
ENABLE_RATE_LIMIT=false
ENABLE_TOOLS=false

# --- Ma'lumotlar bazasi (ENABLE_DATABASE=true bo'lsa ishlatiladi) --------
# Standart: mahalliy SQLite fayli. Productionda PostgreSQL tavsiya etiladi,
# masalan: postgresql://user:parol@host:5432/dbnomi
DATABASE_URL=sqlite:///./app.db

# --- Autentifikatsiya (ENABLE_AUTH=true bo'lsa ishlatiladi) --------------
# MAJBURIY (ENABLE_AUTH=true bo'lsa): tasodifiy va kamida 32 belgili qiymat
# qo'ying, masalan terminalda: openssl rand -hex 32
# Bo'sh yoki standart qiymatda qoldirilsa, server ATAYLAB ishga tushmaydi
# (xavfsizlik uchun fail-fast tekshiruvi — auth.py ga qarang).
JWT_SECRET=

# --- Google orqali kirish (ENABLE_AUTH=true bo'lsa, ixtiyoriy) -----------
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# OAuth client ID -> Web application. Authorized redirect URI'ga aynan
# quyidagi GOOGLE_REDIRECT_URI qiymatini kiriting.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
FRONTEND_LOGIN_SUCCESS_URL=http://127.0.0.1:8000/login.html

# --- Rate limiting (ENABLE_RATE_LIMIT=true bo'lsa ishlatiladi) -----------
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Server porti (ixtiyoriy) ---------------------------------------------
PORT=8000

# --- CORS (tavsiya etiladi) -----------------------------------------------
# Productionda o'z domeningizni ko'rsating (vergul bilan bir nechtasi):
# ALLOWED_ORIGINS=https://mening-domenim.uz
# Bo'sh qoldirilsa standart "*" (hamma domen) ishlatiladi — faqat local
# development uchun mos.
ALLOWED_ORIGINS=*

# --- ENABLE_TOOLS bilan bog'liq resurs chegaralari (ixtiyoriy) -----------
# tools.py dagi run_python_code() uchun. DIQQAT: bular sandbox o'rnini
# BOSMAYDI — faqat qo'shimcha himoya qatlami. tools.py fayli boshidagi
# ogohlantirishni albatta o'qing.
CODE_EXECUTION_TIMEOUT_SECONDS=5
CODE_EXECUTION_MEMORY_LIMIT_BYTES=134217728

# ENABLE_TOOLS=true qilish uchun MAJBURIY: haqiqiy sandbox (Docker/E2B/
# gVisor) qo'llaganingizni ongli ravishda tasdiqlang. Pentest shuni
# ko'rsatdiki, statik filtr YAGONA himoya bo'lganda bir necha soniyada
# chetlab o'tiladi — shuning uchun bu standart holatda false.
CODE_EXECUTION_SANDBOX_CONFIRMED=false

# --- GitHub tool (ixtiyoriy, github_tool.py) -----------------------------
# Claude'ga GitHub repo bilan ishlash (fayl o'qish/yozish, PR ochish)
# imkonini beradi. GITHUB_TOKEN — "fine-grained" shaxsiy token, FAQAT
# kerakli repo(lar)ga va Contents+Pull requests (Read&Write) huquqiga
# cheklangan bo'lishi SHART (github_tool.py dagi ogohlantirishga qarang).
ENABLE_GITHUB_TOOL=false
GITHUB_TOKEN=

# --- Google Docs tool (ixtiyoriy, google_docs_tool.py) --------------------
# Claude'ga Google Docs hujjatlari bilan ishlash (o'qish, yaratish)
# imkonini beradi. Quyidagi GOOGLE_CLIENT_ID/SECRET — auth.py bilan BIR XIL
# OAuth client (console.cloud.google.com -> Google Auth Platform -> Clients).
# DIQQAT: o'sha client'ning "Authorized redirect URIs" ro'yxatiga aynan
# GOOGLE_DOCS_REDIRECT_URI qiymatini QO'SHING (mavjud login redirect
# URI'sini o'chirmang — ikkalasi ham kerak). Ulanish sessiya darajasida:
# foydalanuvchi sozlamalar sahifasidan "Google Docs ulash" tugmasini
# bosadi, bu esa GET /google-docs/connect/{session_id} ga yo'naltiradi.
ENABLE_GOOGLE_DOCS_TOOL=false
GOOGLE_DOCS_REDIRECT_URI=http://127.0.0.1:8000/google-docs/callback
FRONTEND_DOCS_SUCCESS_URL=http://127.0.0.1:8000/settings.html

# --- Login/register brute-force himoyasi (ENABLE_AUTH=true bo'lsa HAR DOIM
# faol, ENABLE_RATE_LIMIT'ga bog'liq emas) ---------------------------------
AUTH_RATE_LIMIT_MAX_REQUESTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
